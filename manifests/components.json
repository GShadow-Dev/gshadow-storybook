        "message": "We could not detect the component from your story file. Specify meta.component.\n  13 | ]\n  14 |\n> 15 | export default { title: 'GSHADOW/Showcase', parameters: { layout: 'fullscreen' } }\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  16 |\n  17 | export const RelayControl = {\n  18 |   render: () => (\n\n./stories/GShadowShowcase.stories.jsx:\nimport '../registry/styles/gshadow.css'\nimport mark from '../brand/gshadow-mark.svg'\nimport { GShadowButton } from '../registry/components/button'\nimport { Metric } from '../registry/components/metric'\nimport { Status } from '../registry/components/status'\nimport { Surface } from '../registry/components/surface'\nimport { ThemeToggle } from '../registry/components/theme-toggle'\n\nconst activity = [\n  ['Spectral sweep', 'Array 09 / 14 nodes resolved', 'success'],\n  ['Protocol review', 'Operator approval required', 'warning'],\n  ['Relay ledger', 'No drift detected', 'info'],\n]\n\nexport default { title: 'GSHADOW/Showcase', parameters: { layout: 'fullscreen' } }\n\nexport const RelayControl = {\n  render: () => (\n    <main className=\"gshadow-showcase\">\n      <div className=\"gshadow-showcase__atmosphere\" aria-hidden=\"true\"><span /><i /><b /></div>\n      <div className=\"gshadow-showcase__wrap\">\n        <header className=\"gshadow-showcase__rail\">\n          <div className=\"gshadow-showcase__brand\"><img src={mark} alt=\"\" /><span>ARCLIGHT RELAY</span><small>FIELD CONSOLE</small></div>\n          <nav aria-label=\"Primary navigation\"><a href=\"#overview\">Overview</a><a href=\"#network\">Network</a><a href=\"#ledger\">Ledger</a></nav>\n          <div className=\"gshadow-showcase__rail-actions\"><Status state=\"success\">SYSTEM NOMINAL</Status><ThemeToggle /></div>\n        </header>\n\n        <section className=\"gshadow-showcase__hero\" id=\"overview\">\n          <div>\n            <p className=\"gshadow-showcase__eyebrow\">NORTH SECTOR / 06:14 UTC</p>\n            <h1>Signals hold.<br /><span>Routes resolve.</span></h1>\n            <p className=\"gshadow-showcase__intro\">Arclight maps unverified relay traffic before it becomes an operational problem. Observe the system, review the handoff, then commit with intention.</p>\n            <div className=\"gshadow-showcase__actions\"><GShadowButton>OPEN SIGNAL MAP</GShadowButton><GShadowButton intent=\"protocol\">VERIFY ROUTE</GShadowButton></div>\n          </div>\n          <Surface elevation=\"raised\" signal=\"convergence\" density=\"comfortable\" className=\"gshadow-showcase__handoff\">\n            <p className=\"gshadow-showcase__eyebrow\">ACTIVE HANDOFF</p>\n            <strong>Array 09 → Relay 42</strong>\n            <p>Two systems agree on the route. One operator confirmation remains.</p>\n            <div className=\"gshadow-showcase__handoff-line\"><span>09</span><i /><span>42</span></div>\n            <Status state=\"warning\">CONFIRMATION WINDOW / 04:32</Status>\n          </Surface>\n        </section>\n\n        <section className=\"gshadow-showcase__metrics\" aria-label=\"Relay metrics\">\n          <Metric signal=\"spectral\" label=\"LIVE SIGNALS\" value=\"1,284\" unit=\"RELAYS\" />\n          <Metric signal=\"neutral\" label=\"ROUTE INTEGRITY\" value=\"99.98\" unit=\"%\" />\n          <Metric signal=\"amber\" label=\"PENDING REVIEW\" value=\"07\" unit=\"ITEMS\" />\n          <Metric signal=\"neutral\" label=\"LATENCY\" value=\"23\" unit=\"MS\" />\n        </section>\n\n        <section className=\"gshadow-showcase__grid\" id=\"network\">\n          <Surface signal=\"spectral\" density=\"comfortable\" className=\"gshadow-showcase__map\">\n            <div className=\"gshadow-showcase__panel-heading\"><div><p className=\"gshadow-showcase__eyebrow\">SPECTRAL LEAD</p><h2>Signal field</h2></div><Status state=\"info\">12 NEW PATHS</Status></div>\n            <div className=\"gshadow-showcase__map-grid\" aria-label=\"Abstract relay map\"><span className=\"gshadow-showcase__node gshadow-showcase__node--start\">N</span><span className=\"gshadow-showcase__node gshadow-showcase__node--one\">A</span><span className=\"gshadow-showcase__node gshadow-showcase__node--two\">R</span><span className=\"gshadow-showcase__node gshadow-showcase__node--end\">9</span><i className=\"gshadow-showcase__path gshadow-showcase__path--one\" /><i className=\"gshadow-showcase__path gshadow-showcase__path--two\" /><i className=\"gshadow-showcase__path gshadow-showcase__path--three\" /></div>\n            <p className=\"gshadow-showcase__caption\">Use spectral for discovery: live topology, selected paths, and reversible investigation.</p>\n          </Surface>\n\n          <div className=\"gshadow-showcase__right-column\">\n            <Surface signal=\"amber\" density=\"comfortable\" className=\"gshadow-showcase__review\">\n              <div className=\"gshadow-showcase__panel-heading\"><div><p className=\"gshadow-showcase__eyebrow\">AMBER LEAD</p><h2>Protocol queue</h2></div><Status state=\"warning\">07 OPEN</Status></div>\n              <ol>{['Route 42 attestation', 'North-array capacity shift', 'Relay 17 access scope'].map((item, index) => <li key={item}><span>0{index + 1}</span><strong>{item}</strong><GShadowButton intent=\"ghost\" size=\"sm\">REVIEW</GShadowButton></li>)}</ol>\n            </Surface>\n            <Surface signal=\"neutral\" density=\"comfortable\" className=\"gshadow-showcase__activity\" id=\"ledger\">\n              <div className=\"gshadow-showcase__panel-heading\"><div><p className=\"gshadow-showcase__eyebrow\">NEUTRAL FIELD</p><h2>Relay ledger</h2></div><a href=\"#ledger\">VIEW ALL →</a></div>\n              <ul>{activity.map(([title, detail, state]) => <li key={title}><Status state={state}>{title.toUpperCase()}</Status><span>{detail}</span></li>)}</ul>\n            </Surface>\n          </div>\n        </section>\n\n        <footer className=\"gshadow-showcase__footer\"><span>ARCLIGHT RELAY / FIELD OPERATIONS</span><span>ONE FIELD. TWO SIGNALS. NO NOISE.</span></footer>\n      </div>\n    </main>\n  ),\n}\n"
