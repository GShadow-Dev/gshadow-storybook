tion>VIEW EVIDENCE</Action>\n            <Action intent=\"secondary\">COMPONENT LOG</Action>\n          </div>\n        </div>\n        <aside className=\"gshadow-console__signal\">\n          <p className=\"gshadow-console__label\">SIGNAL STATE</p>\n          <p className=\"gshadow-metric__value\">LOCKED</p>\n          <span className=\"gshadow-status gshadow-status--success\"><i className=\"gshadow-status__dot\" />SYSTEMS NOMINAL</span>\n        </aside>\n      </section>\n\n      <section className=\"gshadow-console__metric-grid\" aria-label=\"Operational metrics\">\n        {metrics.map(([label, value, unit, detail, state]) => (\n          <article className=\"gshadow-console__metric\" key={label}>\n            <p className=\"gshadow-metric__label\">{label}</p>\n            <div className=\"gshadow-metric__value\">{value}{unit && <span className=\"gshadow-metric__unit\">{unit}</span>}</div>\n            <span className={`gshadow-status gshadow-status--${state}`}><i className=\"gshadow-status__dot\" />{detail}</span>\n          </article>\n        ))}\n      </section>\n    </main>\n  ),\n}\n"
