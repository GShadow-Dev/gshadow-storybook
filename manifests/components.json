        "name": "No component found",
        "message": "We could not detect the component from your story file. Specify meta.component.\n  11 | ]\n  12 |\n> 13 | export default { title: 'GSHADOW/Foundation', parameters: { layout: 'fullscreen' } }\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  14 |\n  15 | function FoundationCanvas() {\n  16 |   const reduceMotion = useReducedMotion()\n\n./stories/GShadowFoundation.stories.jsx:\nimport '../registry/styles/gshadow.css'\nimport mark from '../brand/gshadow-mark.svg'\nimport { motion, useReducedMotion } from 'motion/react'\n\nconst metrics = [['SIGNAL INDEX', '84.2', '+12.4%', 'spectral'], ['PROTOCOL LOAD', '66.8', '+8.7%', 'amber'], ['ACTIVE THREADS', '1,284', '+9.3%', 'spectral'], ['LOCKED FLOWS', '18', 'NOMINAL', 'amber']]\nconst combinations = [\n  ['SPECTRAL LEAD', 'Explore → commit', 'Use violet for the active workspace, then use one amber control for the irreversible action.', 'spectral-lead'],\n  ['AMBER LEAD', 'Scrutinize → verify', 'Use amber for a bounded review, exception, or policy surface; spectral remains supporting metadata.', 'amber-lead'],\n  ['CONVERGENCE', 'Compare → hand off', 'Use the gradient seam only when two systems, assets, or signals meet. Keep it brief and centered on the handoff.', 'convergence'],\n  ['NEUTRAL FIELD', 'Read → orient', 'Use the cool midnight substrate for routine content. Neither signal family is required just because a panel exists.', 'neutral-field'],\n]\n\nexport default { title: 'GSHADOW/Foundation', parameters: { layout: 'fullscreen' } }\n\nfunction FoundationCanvas() {\n  const reduceMotion = useReducedMotion()\n\n  const drift = reduceMotion ? {} : { x: [0, 8, -5, 0], y: [0, -5, 4, 0], opacity: [.72, .94, .78, .72], scale: [1, 1.035, 1.01, 1] }\n\n  return (\n    <main className=\"gshadow-foundation\">\n      <div className=\"gshadow-foundation__atmosphere\" aria-hidden=\"true\">\n        <motion.div className=\"gshadow-foundation__atmosphere-field gshadow-foundation__atmosphere-field--spectral\" animate={drift} transition={{ duration: 32, ease: 'easeInOut', repeat: Infinity }} />\n        <motion.div className=\"gshadow-foundation__atmosphere-field gshadow-foundation__atmosphere-field--amber\" animate={reduceMotion ? {} : { x: [0, -7, 4, 0], y: [0, 5, -4, 0], opacity: [.68, .90, .74, .68], scale: [1, 1.04, 1.015, 1] }} transition={{ duration: 38, ease: 'easeInOut', repeat: Infinity }} />\n        <motion.div className=\"gshadow-foundation__atmosphere-field gshadow-foundation__atmosphere-field--seam\" animate={reduceMotion ? {} : { x: ['-2%', '2%', '-1%', '-2%'], opacity: [.22, .44, .29, .22], scaleX: [1, 1.07, 1.02, 1] }} transition={{ duration: 26, ease: 'easeInOut', repeat: Infinity }} />\n      </div>\n      <div className=\"gshadow-foundation__wrap\">\n        <header className=\"gshadow-foundation__rail\">\n          <div className=\"gshadow-foundation__identity\"><img className=\"gshadow-foundation__mark\" src={mark} alt=\"\" /><span>GSHADOW</span></div>\n          <span className=\"gshadow-foundation__meta\">FOUNDATION / SIGNAL FAMILIES</span>\n        </header>\n        <section className=\"gshadow-foundation__hero\">\n          <div><p className=\"gshadow-foundation__meta\">ONE FIELD. TWO SIGNALS.</p><h1 className=\"gshadow-foundation__title\">Watch the <span>dark.</span><br />Mark the heat.</h1><p className=\"gshadow-foundation__copy\">A dual-signal system for operational interfaces. Spectral tracks what is hidden. Amber marks what needs deliberate focus. Both share the same calm substrate.</p><div className=\"gshadow-foundation__actions\"><button className=\"gshadow-foundation__action gshadow-foundation__action--spectral\">EXPLORE SIGNAL →</button><button className=\"gshadow-foundation__action gshadow-foundation__action--amber\">OPEN PROTOCOL →</button></div></div>\n          <div className=\"gshadow-foundation__convergence\"><motion.div className=\"gshadow-foundation__orb gshadow-foundation__orb--spectral\" animate={reduceMotion ? {} : { y: [0, -2, 0], rotate: [0, -.45, 0] }} transition={{ duration: 9, ease: 'easeInOut', repeat: Infinity }}><img src={mark} alt=\"\" /></motion.div><motion.div className=\"gshadow-foundation__seam\" animate={reduceMotion ? {} : { opacity: [.48, .72, .48], scaleY: [.94, .98, .94] }} transition={{ duration: 8, ease: 'easeInOut', repeat: Infinity }} /><motion.div className=\"gshadow-foundation__orb gshadow-foundation__orb--amber\" animate={reduceMotion ? {} : { y: [0, 2, 0], rotate: [0, .45, 0] }} transition={{ duration: 10, ease: 'easeInOut', repeat: Infinity }}>↯</motion.div></div>\n          <aside className=\"gshadow-foundation__signal\"><p className=\"gshadow-foundation__meta\">AMBER PROTOCOL</p><strong>CONTAINMENT READY</strong><p>Use amber as a bounded operational callout. It is not a second primary color.</p></aside>\n        </section>\n        <section className=\"gshadow-foundation__metrics\">{metrics.map(([label, value, delta, family], index) => <motion.article className={`gshadow-foundation__metric gshadow-foundation__metric--${family}`} key={label} initial={reduceMotion ? false : { opacity: 0, y: 5 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: .12 + index * .05, duration: .5, ease: 'easeOut' }} whileHover={reduceMotion ? undefined : { y: -1, transition: { duration: .22 } }}><p>{label}</p><strong>{value}</strong><span>{delta}</span><i /></motion.article>)}</section>\n        <section className=\"gshadow-foundation__bridge\"><div><p className=\"gshadow-protocol__eyebrow\">CONVERGENCE / SHARED FIELD</p><h2>Two signals.<br />One operating field.</h2></div><p>Violet owns discovery and motion. Amber owns scrutiny and commitment. Between them, the system uses a short, controlled gradient handoff.</p><div className=\"gshadow-foundation__bridge-mark\"><img src={mark} alt=\"\" /><span>↯</span></div></section>\n        <section className=\"gshadow-foundation__protocols\" aria-label=\"GSHADOW signal families\">\n          <article className=\"gshadow-protocol gshadow-protocol--spectral\"><p className=\"gshadow-protocol__eyebrow\">SPECTRAL SIGNAL / DEFAULT</p><h2>Observe the hidden.</h2><p className=\"gshadow-protocol__copy\">Black-blue, electric violet, and deep ultraviolet create a strong signal without turning the interface into a purple wash.</p><div className=\"gshadow-protocol__tokens\"><span className=\"gshadow-protocol__token\"><i style={{ background: '#6821DE' }} />ELECTRIC VIOLET</span><span className=\"gshadow-protocol__token\"><i style={{ background: '#100829' }} />ULTRAVIOLET DEPTH</span></div></article>\n          <article className=\"gshadow-protocol gshadow-protocol--amber\"><p className=\"gshadow-protocol__eyebrow\">AMBER PROTOCOL / ESCALATION</p><h2>Contain the heat.</h2><p className=\"gshadow-protocol__copy\">Burnt gold and warm ember are reserved for focus, scrutiny, and an intentional next move. The family shares the same black-blue substrate.</p><div className=\"gshadow-protocol__tokens\"><span className=\"gshadow-protocol__token\"><i style={{ background: '#E79222' }} />GOLD TRACE</span><span className=\"gshadow-protocol__token\"><i style={{ background: '#2B1503' }} />EMBER DEPTH</span></div></article>\n        </section>\n        <section className=\"gshadow-foundation__combinations\" aria-labelledby=\"combination-title\">\n          <div className=\"gshadow-foundation__combination-heading\"><p className=\"gshadow-protocol__eyebrow\">DUAL-SIGNAL PROTOCOL</p><h2 id=\"combination-title\">Color has a job.</h2><p>Choose a relationship based on the user’s task—not to make the screen louder. A region gets one lead, one supporting family, or a neutral field.</p></div>\n          <div className=\"gshadow-foundation__combination-grid\">{combinations.map(([label, use, description, style]) => <article className={`gshadow-foundation__combination gshadow-foundation__combination--${style}`} key={label}><p>{label}</p><strong>{use}</strong><span>{description}</span></article>)}</div>\n        </section>\n        <p className=\"gshadow-foundation__rule\"><strong>COMPOSITION RULE</strong><span>Use one signal family to lead a region. Spectral and amber can share a page through common neutrals, structure, and typography. Do not layer both glow systems into the same component.</span></p>\n      </div>\n    </main>\n  )\n}\n\nexport const CoreLanguage = {\n  render: () => <FoundationCanvas />,\n}\n"
      },
