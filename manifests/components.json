      "error": {
        "name": "No component found",
        "message": "We could not detect the component from your story file. Specify meta.component.\n  38 | )\n  39 |\n> 40 | export default { title: 'GSHADOW/Registry', parameters: { layout: 'fullscreen' } }\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  41 |\n  42 | export const Base = {\n  43 |   render: () => <Frame\n\n./stories/GShadowPrimitives.stories.jsx:\nimport '../registry/styles/gshadow.css'\nimport { GShadowButton as GShadowButtonComponent } from '../registry/components/button'\nimport { Metric as GShadowMetric } from '../registry/components/metric'\nimport { ModeScript as GShadowModeScript } from '../registry/components/mode-script'\nimport { Status as GShadowStatus } from '../registry/components/status'\nimport { Surface as GShadowSurface } from '../registry/components/surface'\nimport { ThemeToggle as GShadowThemeToggle } from '../registry/components/theme-toggle'\nimport { cn } from '../registry/lib/utils'\n\nconst Frame = ({ title, eyebrow, summary, contract, children }) => (\n  <main className=\"gshadow-story-frame\">\n    <div className=\"gshadow-story-content\">\n      <header className=\"gshadow-story-header\">\n        <div>\n          <p className=\"gshadow-story-label\">{eyebrow}</p>\n          <h1 className=\"gshadow-story-title\">{title}</h1>\n          <p className=\"gshadow-story-copy\">{summary}</p>\n        </div>\n        <p className=\"gshadow-story-contract\">{contract}</p>\n      </header>\n      {children}\n    </div>\n  </main>\n)\n\nconst Section = ({ title, index, children }) => (\n  <section className=\"gshadow-story-section\">\n    <h2 className=\"gshadow-story-section-heading\"><span>{index}</span>{title}</h2>\n    {children}\n  </section>\n)\n\nconst Guidance = ({ use, avoid }) => (\n  <div className=\"gshadow-story-guidance\">\n    <div><h3>USE IT FOR</h3><p>{use}</p></div>\n    <div><h3>NOT FOR</h3><p>{avoid}</p></div>\n  </div>\n)\n\nexport default { title: 'GSHADOW/Registry', parameters: { layout: 'fullscreen' } }\n\nexport const Base = {\n  render: () => <Frame\n    eyebrow=\"FOUNDATION / TOKENS / TYPE / FOCUS\"\n    title=\"A system with a pulse.\"\n    summary=\"The baseline is warm and legible in light mode, quiet and watchful in void-dark. Violet is an operational signal, never the room itself.\"\n    contract=\"Semantic names stay stable across modes. Components only consume semantic tokens, so a theme change never requires a component rewrite.\"\n  >\n    <Section index=\"01\" title=\"Semantic color roles\">\n      <div className=\"gshadow-story-token-grid\">\n        {[\n          ['background', 'canvas'], ['card', 'surface'], ['foreground', 'primary text'],\n          ['primary', 'action / trace'], ['border', 'structure'], ['destructive', 'danger'],\n        ].map(([token, use]) => <div className=\"gshadow-story-token\" key={token}><i style={{ background: `var(--${token})` }} /><span>{token}<br /><small>{use}</small></span></div>)}\n      </div>\n    </Section>\n    <Section index=\"02\" title=\"Usage boundary\">\n      <Guidance use=\"Use violet for one active action, selected state, focus ring, or a single trace edge in a composition.\" avoid=\"Do not wash a page in violet gradients, glow every status dot, or use color as the only status signal.\" />\n    </Section>\n  </Frame>,\n}\n\nexport const Utilities = {\n  render: () => <Frame\n    eyebrow=\"UTILITY / CLASS COMPOSITION\"\n    title=\"The quiet machinery.\"\n    summary=\"The class merger lets a consumer compose a documented primitive without fighting its contract or duplicating style bundles.\"\n    contract=\"Utilities protect the system from accidental overrides. They are infrastructure, not a visual feature.\"\n  >\n    <Section index=\"01\" title=\"Composition result\">\n      <div className=\"gshadow-story-stage\"><GShadowSurface className={cn('gshadow-surface--trace')} elevation=\"trace\" density=\"comfortable\"><GShadowStatus state=\"info\">UTILITY CONTRACT ACTIVE</GShadowStatus></GShadowSurface></div>\n    </Section>\n    <Section index=\"02\" title=\"The exact class merge\"><pre className=\"gshadow-story-code\">{cn('gshadow-surface', 'gshadow-surface--trace', 'gshadow-surface--comfortable')}</pre></Section>\n    <Section index=\"03\" title=\"Usage boundary\"><Guidance use=\"Extend a documented primitive through its named props and a small local class adjustment.\" avoid=\"Copy a giant visual class string into product pages or invent a one-off color variant.\" /></Section>\n  </Frame>,\n}\n\nexport const ModeScript = {\n  render: () => <Frame\n    eyebrow=\"MODE SCRIPT / PRE-PAINT PERSISTENCE\"\n    title=\"No flash. No guesswork.\"\n    summary=\"The pre-paint script restores an explicit warm-light or void-dark choice before the interface renders. Without one, it follows the operating system.\"\n    contract=\"The theme contract is light, dark, or system default. It never asks a component to discover the current theme itself.\"\n  >\n    <GShadowModeScript />\n    <Section index=\"01\" title=\"Live state\"><div className=\"gshadow-story-stage\"><GShadowStatus state=\"success\">MODE CONTRACT ACTIVE</GShadowStatus></div></Section>\n    <Section index=\"02\" title=\"Usage boundary\"><Guidance use=\"Mount it once at the document root before product content begins rendering.\" avoid=\"Mount one script per component, or use it as a visual mode switcher.\" /></Section>\n  </Frame>,\n}\n\nexport const ThemeToggle = {\n  render: () => <Frame\n    eyebrow=\"THEME TOGGLE / DIRECT LIGHT-DARK SWITCH\"\n    title=\"Change the field in one move.\"\n    summary=\"A single press switches directly between warm-light and void-dark. System preference is only the starting point, not a third stop in the interaction.\"\n    contract=\"The hit area is 44 px. The control persists an explicit choice and announces the mode it will switch to.\"\n  >\n    <Section index=\"01\" title=\"Live example\"><div className=\"gshadow-story-stage\"><GShadowThemeToggle /></div></Section>\n    <Section index=\"02\" title=\"Interaction rule\"><Guidance use=\"Place this at a global level where users expect environment controls, such as the application rail.\" avoid=\"Hide the state in a menu without a visible affordance or require repeated taps to change modes.\" /></Section>\n  </Frame>,\n}\n\nexport const Button = {\n  render: () => <Frame\n    eyebrow=\"BUTTON / INTENT / SIZE / LOADING\"\n    title=\"Actions with a reason.\"\n    summary=\"Buttons communicate action priority before decoration. The primary action earns the only concentrated violet on this surface.\"\n    contract=\"Use intent, size, and state. The protocol intent is amber because it means verify, approve, or commit—not because the page needs more color.\"\n  >\n    <Section index=\"01\" title=\"Intent\"><div className=\"gshadow-story-stage\"><div className=\"gshadow-story-row\"><GShadowButtonComponent intent=\"primary\">VIEW EVIDENCE</GShadowButtonComponent><GShadowButtonComponent intent=\"protocol\">VERIFY CHANGE</GShadowButtonComponent><GShadowButtonComponent intent=\"secondary\">OPEN LOG</GShadowButtonComponent><GShadowButtonComponent intent=\"ghost\">DISMISS</GShadowButtonComponent><GShadowButtonComponent intent=\"danger\">PURGE</GShadowButtonComponent></div></div></Section>\n    <Section index=\"02\" title=\"Size and state\"><div className=\"gshadow-story-stage\"><div className=\"gshadow-story-row\"><GShadowButtonComponent size=\"sm\">COMPACT</GShadowButtonComponent><GShadowButtonComponent size=\"md\">DEFAULT</GShadowButtonComponent><GShadowButtonComponent size=\"lg\">PROMINENT</GShadowButtonComponent><GShadowButtonComponent loading>WORKING</GShadowButtonComponent><GShadowButtonComponent disabled>UNAVAILABLE</GShadowButtonComponent></div></div></Section>\n    <Section index=\"03\" title=\"Usage boundary\"><Guidance use=\"Use primary for the single next move, protocol for verification or an intentional commitment, secondary for an equal alternative, ghost for low-emphasis actions, and danger for irreversible work.\" avoid=\"Put primary and protocol beside each other without a clear sequence, or use amber merely to add visual excitement.\" /></Section>\n  </Frame>,\n}\n\nexport const Surface = {\n  render: () => <Frame\n    eyebrow=\"SURFACE / BASE / RAISED / TRACE\"\n    title=\"Structure without chrome.\"\n    summary=\"Surfaces create hierarchy with containment, spacing, and a rare trace. The dark field stays deep, but it does not become a purple fog machine.\"\n    contract=\"Elevation sets hierarchy. Signal sets the job: neutral reads, spectral explores, amber verifies, and convergence compares or hands off.\"\n  >\n    <Section index=\"01\" title=\"Elevation\"><div className=\"gshadow-story-surface-grid\">{[['base', 'Calm containment'], ['raised', 'Separate a task'], ['trace', 'Direct attention']].map(([elevation, copy]) => <GShadowSurface key={elevation} elevation={elevation} density=\"comfortable\"><p className=\"gshadow-story-label\">{elevation}</p><strong>{copy}</strong><p className=\"gshadow-story-copy\">Use this level only when its hierarchy has a job to do.</p></GShadowSurface>)}</div></Section>\n    <Section index=\"02\" title=\"Signal family\"><div className=\"gshadow-story-surface-grid\">{[['neutral', 'Routine reading'], ['spectral', 'Discovery workspace'], ['amber', 'Review boundary'], ['convergence', 'Comparison / handoff']].map(([signal, copy]) => <GShadowSurface key={signal} elevation=\"base\" signal={signal} density=\"comfortable\"><p className=\"gshadow-story-label\">{signal}</p><strong>{copy}</strong></GShadowSurface>)}</div></Section>\n    <Section index=\"03\" title=\"Usage boundary\"><Guidance use=\"Use neutral for routine reading, spectral for discovery, amber for a bounded review or verification, and convergence only where two systems actually meet.\" avoid=\"Stack raised cards, add decorative gradients, or apply convergence to a generic container.\" /></Section>\n  </Frame>,\n}\n\nexport const Metric = {\n  render: () => <Frame\n    eyebrow=\"METRIC / TABULAR VALUE / UNIT\"\n    title=\"Numbers that hold their line.\"\n    summary=\"Operational values use Manrope with tabular lining figures. Labels are mono. Units breathe at a smaller scale and always keep one space from the value.\"\n    contract=\"Metric data stays readable at a glance. Its signal treatment follows the region it belongs to; it never assigns importance by color alone.\"\n  >\n    <Section index=\"01\" title=\"Operational examples\"><div className=\"gshadow-story-surface-grid\"><GShadowMetric signal=\"spectral\" label=\"ACTIVE SIGNALS\" value=\"1,284\" unit=\"OPS\" /><GShadowMetric signal=\"amber\" label=\"RESERVE\" value=\"321\" unit=\"GB\" /><GShadowMetric signal=\"neutral\" label=\"SUCCESS RATE\" value=\"99.8\" unit=\"%\" /></div></Section>\n    <Section index=\"02\" title=\"Usage boundary\"><Guidance use=\"Use spectral metrics for discovery data, amber metrics inside review or protocol regions, and neutral metrics for routine reading. Every metric still needs a precise label and unit.\" avoid=\"Use metrics for paragraphs, status messages, or values that need explanatory prose to be understood.\" /></Section>\n  </Frame>,\n}\n\nexport const Status = {\n  render: () => <Frame\n    eyebrow=\"STATUS / TEXT + SIGNAL\"\n    title=\"Readable without color.\"\n    summary=\"Status combines a named state, mono label, and a restrained dot. Color reinforces the message; it is never the only message.\"\n    contract=\"Use the four named states. Keep the wording direct enough that the status survives monochrome or reduced vision.\"\n  >\n    <Section index=\"01\" title=\"State examples\"><div className=\"gshadow-story-status-list\"><GShadowStatus state=\"success\">PROBE CLEAN</GShadowStatus><GShadowStatus state=\"warning\">LATENCY WATCH</GShadowStatus><GShadowStatus state=\"error\">ACTION REQUIRED</GShadowStatus><GShadowStatus state=\"info\">LOG INDEXED</GShadowStatus></div></Section>\n    <Section index=\"02\" title=\"Usage boundary\"><Guidance use=\"Pair status with a concise observed condition, especially in operational UI and system feedback.\" avoid=\"Use status color as decoration, or hide a critical action behind a vague label like “Attention.”\" /></Section>\n  </Frame>,\n}\n"
      },
