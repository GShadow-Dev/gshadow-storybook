          "snippet": "const CoreLanguage = () => (\n  <main className=\"gshadow-console\">\n    <header className=\"gshadow-console__rail\">\n      <div className=\"gshadow-console__identity\">\n        <img className=\"gshadow-console__mark\" src={mark} alt=\"\" />\n        <span>GSHADOW</span>\n      </div>\n      <span className=\"gshadow-console__label\">FOUNDATION / 0.1 / VOID READY</span>\n    </header>\n\n    <section className=\"gshadow-console__grid\">\n      <div>\n        <p className=\"gshadow-console__label\">EVIDENCE CONSOLE</p>\n        <h1 className=\"gshadow-console__title\">Evidence first.<br /><em>Noise suppressed.</em></h1>\n        <p className=\"gshadow-console__intro\">A component language for systems that need to read clean under pressure. Warm light for ordinary work. Void-dark when the signal matters.</p>\n        <div className=\"gshadow-console__actions\">\n          <Action>VIEW EVIDENCE</Action>\n          <Action intent=\"secondary\">COMPONENT LOG</Action>\n        </div>\n      </div>\n      <aside className=\"gshadow-console__signal\">\n        <p className=\"gshadow-console__label\">SIGNAL STATE</p>\n        <p className=\"gshadow-metric__value\">LOCKED</p>\n        <span className=\"gshadow-status gshadow-status--success\"><i className=\"gshadow-status__dot\" />SYSTEMS NOMINAL</span>\n      </aside>\n    </section>\n\n    <section className=\"gshadow-console__metric-grid\" aria-label=\"Operational metrics\">\n      {metrics.map(([label, value, unit, detail, state]) => (\n        <article className=\"gshadow-console__metric\" key={label}>\n          <p className=\"gshadow-metric__label\">{label}</p>\n          <div className=\"gshadow-metric__value\">{value}{unit && <span className=\"gshadow-metric__unit\">{unit}</span>}</div>\n          <span className={`gshadow-status gshadow-status--${state}`}><i className=\"gshadow-status__dot\" />{detail}</span>\n        </article>\n      ))}\n    </section>\n  </main>\n);"
